    {
      "layout": "raw",
      "id": "gist-listen",
      "step": 1,
      "background_color": "#c0392b",
      "body": "<style>body{color:#fff}.tb{border-collapse:collapse;margin:15px auto;max-width:800px;width:100%%}.tb td{padding:10px 16px;border-bottom:1px solid rgba(255,255,255,0.12);text-align:left;vertical-align:top;font-size:35px}.tb tr:last-child td{border-bottom:none}.lbl{color:#ffdd00;font-weight:700;white-space:nowrap;width:120px}</style><h2 style=\"color:#fff;text-align:center;font-size:46px;margin-bottom:10px\">Listen: Gist</h2><table class=\"tb\"><tr><td class=\"lbl\">Task</td><td>Listen to a radio show about a documentary called <em>Human</em>.</td></tr><tr><td class=\"lbl\">Question 1</td><td>What is it about?</td></tr><tr><td class=\"lbl\">Question 2</td><td>How does it engage you?</td></tr></table><div style=\"text-align:center;margin-top:20px\"><audio controls src=\"assets/ODF3_SB_1.15.mp3\" style=\"width:360px\"></audio></div>",
      "notes": "Play audio track 1.15 without pausing."
