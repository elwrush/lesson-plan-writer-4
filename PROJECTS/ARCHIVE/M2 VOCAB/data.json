    {
      "layout": "content",
      "id": "spelling-task",
      "step": 1,
      "background_color": "#c0392b",
      "title": "Spelling Test",
      "body": "<p style=\"font-size:38px;color:#fff;margin:0 0 12px 0\">Listen and write the 20 words.</p><p style=\"font-size:38px;color:#fff;margin:0 0 20px 0\">Each word comes twice, with a sentence.</p><div style=\"text-align:center\"><audio controls data-src=\"assets/spelling-test.mp3\" style=\"width:340px\"></audio></div>",
      "notes": "Hand out the answer sheets. Play the audio once only. Then students swap and mark against the answer slides. Collect the sheets after marking."
    },
    {
      "layout": "raw",
      "id": "spelling-answers-1",
      "step": 1,
      "background_color": "#052e0d",
      "body": "<style>.s1{border-collapse:collapse;margin:8px auto;max-width:760px;width:100%}.s1 td{padding:10px 14px;border-bottom:1px solid rgba(255,255,255,0.1);color:#fff;text-align:left;font-size:38px;vertical-align:top}.s1 .num{color:#ffdd00;font-weight:700;min-width:40px}.s1 .ans{color:#ffdd00;font-weight:700;border:2px solid #ffdd00;border-radius:4px;padding:1px 12px}</style><h2 style=\"color:#fff;text-align:center;font-size:44px;margin-bottom:10px\">Spelling Test — Answers (1/4)</h2><p style=\"color:#fff;text-align:center;font-size:34px;margin-bottom:12px\"><span class=\"box-word\">Swap</span> and <span class=\"box-word\">mark</span>.</p><table class=\"s1\"><tr class=\"fragment\"><td class=\"num\">1</td><td><span class=\"ans\">pollution</span></td></tr><tr class=\"fragment\"><td class=\"num\">2</td><td><span class=\"ans\">disease</span></td></tr><tr class=\"fragment\"><td class=\"num\">3</td><td><span class=\"ans\">education</span></td></tr><tr class=\"fragment\"><td class=\"num\">4</td><td><span class=\"ans\">environment</span></td></tr><tr class=\"fragment\"><td class=\"num\">5</td><td><span class=\"ans\">charity</span></td></tr></table>",
      "notes": "Answer key 1-5. Students swap and mark."
    },
    {
      "layout": "raw",
      "id": "spelling-answers-2",
      "step": 1,
      "background_color": "#052e0d",
      "body": "<style>.s2{border-collapse:collapse;margin:8px auto;max-width:760px;width:100%}.s2 td{padding:10px 14px;border-bottom:1px solid rgba(255,255,255,0.1);color:#fff;text-align:left;font-size:38px;vertical-align:top}.s2 .num{color:#ffdd00;font-weight:700;min-width:40px}.s2 .ans{color:#ffdd00;font-weight:700;border:2px solid #ffdd00;border-radius:4px;padding:1px 12px}</style><h2 style=\"color:#fff;text-align:center;font-size:44px;margin-bottom:10px\">Spelling Test — Answers (2/4)</h2><p style=\"color:#fff;text-align:center;font-size:34px;margin-bottom:12px\"><span class=\"box-word\">Swap</span> and <span class=\"box-word\">mark</span>.</p><table class=\"s2\"><tr class=\"fragment\"><td class=\"num\">6</td><td><span class=\"ans\">encourage</span></td></tr><tr class=\"fragment\"><td class=\"num\">7</td><td><span class=\"ans\">respect</span></td></tr><tr class=\"fragment\"><td class=\"num\">8</td><td><span class=\"ans\">global</span></td></tr><tr class=\"fragment\"><td class=\"num\">9</td><td><span class=\"ans\">convince</span></td></tr><tr class=\"fragment\"><td class=\"num\">10</td><td><span class=\"ans\">volunteer</span></td></tr></table>",
      "notes": "Answer key 6-10. Students swap and mark."
    },
    {
      "layout": "raw",
      "id": "spelling-answers-3",
      "step": 1,
      "background_color": "#052e0d",
      "body": "<style>.s3{border-collapse:collapse;margin:8px auto;max-width:760px;width:100%}.s3 td{padding:10px 14px;border-bottom:1px solid rgba(255,255,255,0.1);color:#fff;text-align:left;font-size:38px;vertical-align:top}.s3 .num{color:#ffdd00;font-weight:700;min-width:40px}.s3 .ans{color:#ffdd00;font-weight:700;border:2px solid #ffdd00;border-radius:4px;padding:1px 12px}</style><h2 style=\"color:#fff;text-align:center;font-size:44px;margin-bottom:10px\">Spelling Test — Answers (3/4)</h2><p style=\"color:#fff;text-align:center;font-size:34px;margin-bottom:12px\"><span class=\"box-word\">Swap</span> and <span class=\"box-word\">mark</span>.</p><table class=\"s3\"><tr class=\"fragment\"><td class=\"num\">11</td><td><span class=\"ans\">effort</span></td></tr><tr class=\"fragment\"><td class=\"num\">12</td><td><span class=\"ans\">poverty</span></td></tr><tr class=\"fragment\"><td class=\"num\">13</td><td><span class=\"ans\">issue</span></td></tr><tr class=\"fragment\"><td class=\"num\">14</td><td><span class=\"ans\">donate</span></td></tr><tr class=\"fragment\"><td class=\"num\">15</td><td><span class=\"ans\">campaign</span></td></tr></table>",
      "notes": "Answer key 11-15. Students swap and mark."
    },
    {
      "layout": "raw",
      "id": "spelling-answers-4",
      "step": 1,
      "background_color": "#052e0d",
      "body": "<style>.s4{border-collapse:collapse;margin:8px auto;max-width:760px;width:100%}.s4 td{padding:10px 14px;border-bottom:1px solid rgba(255,255,255,0.1);color:#fff;text-align:left;font-size:38px;vertical-align:top}.s4 .num{color:#ffdd00;font-weight:700;min-width:40px}.s4 .ans{color:#ffdd00;font-weight:700;border:2px solid #ffdd00;border-radius:4px;padding:1px 12px}</style><h2 style=\"color:#fff;text-align:center;font-size:44px;margin-bottom:10px\">Spelling Test — Answers (4/4)</h2><p style=\"color:#fff;text-align:center;font-size:34px;margin-bottom:12px\"><span class=\"box-word\">Swap</span> and <span class=\"box-word\">mark</span>.</p><table class=\"s4\"><tr class=\"fragment\"><td class=\"num\">16</td><td><span class=\"ans\">hunger</span></td></tr><tr class=\"fragment\"><td class=\"num\">17</td><td><span class=\"ans\">housing</span></td></tr><tr class=\"fragment\"><td class=\"num\">18</td><td><span class=\"ans\">blame</span></td></tr><tr class=\"fragment\"><td class=\"num\">19</td><td><span class=\"ans\">refugee</span></td></tr><tr class=\"fragment\"><td class=\"num\">20</td><td><span class=\"ans\">conflict</span></td></tr></table>",
      "notes": "Answer key 16-20. Students swap and mark."
