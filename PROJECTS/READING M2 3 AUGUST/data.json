    {
      "layout": "raw",
      "id": "pre-task",
      "step": 1,
      "background_color": "#1a1a2e",
      "body": "<p style=\"color:#fff;text-align:center;font-size:44px;font-weight:700\">Read &amp; Answer</p><p style=\"color:#fff;text-align:center;font-size:35px\">Read the text on your worksheet.<br>Answer the questions.</p><p style=\"color:#ffdd00;text-align:center;font-size:35px;margin-top:20px\">Grab a B2 text from the back of the room and see if you can complete with 10 minutes to go.</p>",
      "notes": "Class reads the B1 text together, then students answer the 8 questions. Fast finishers grab the B2 text (challenge)."
    },
    {
      "layout": "raw",
      "id": "main-task",
      "step": 1,
      "background_color": "#1a1a2e",
      "body": "<p style=\"color:#fff;text-align:center;font-size:44px;font-weight:700\">Listen &amp; Read</p><p style=\"color:#fff;text-align:center;font-size:35px\">Listen to the text.<br>Follow along on your worksheet.<br>Answer the questions.</p><div style=\"text-align:center;margin-top:24px\"><audio controls data-src=\"assets/b1-monolog.mp3\" style=\"width:420px\"></audio></div><p style=\"color:#ffdd00;text-align:center;font-size:35px;margin-top:20px\">Check your answers at the gallery walk.</p>",
      "notes": "Play the monolog (narrator reads the B1 text). Students listen and follow along, then answer. Remind them: answers are on the walls."
    },
