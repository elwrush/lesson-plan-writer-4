      "body": "<table style=\"width:100%;text-align:left;border-collapse:collapse;margin-top:30px\"><tr><td style=\"padding:12px 0;font-size:56px\">/streɪn/</td></tr><tr class=\"fragment\"><td style=\"padding:12px 0\"><span class=\"box-word\">strain</span></td></tr><tr class=\"fragment\"><td style=\"padding:12px 0\">Doctors study each new <span class=\"box-word\">strain</span> of the virus. It is a different type of the same disease.</td></tr></table>",
