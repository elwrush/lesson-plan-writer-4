# Secrets
.env
.env.*

# Generated PDFs (worksheets, answer sheets, reports, lesson plans)
PROJECTS/**/*.pdf
PDF/

# Slides (belong on GitHub Pages, not in codebase)
**/slides/
M2-slides/

# Binary assets (logos, audio, images — not source code)
ASSETS/

# Binary/media files (never commit — exclude everywhere)
**/*.png
**/*.jpg
**/*.jpeg
**/*.gif
**/*.webp
**/*.svg
**/*.mp3
**/*.wav
**/*.ogg
**/*.mp4
**/*.mov
**/*.avi
**/*.zip
**/*.tar
**/*.gz
**/*.7z
**/*.rar
**/*.exe
**/*.dll
**/*.so
**/*.dylib
**/*.bin
**/*.wasm
**/*.class
**/*.jar
**/*.pdf

# Node.js
node_modules/
package-lock.json

# Python artifacts
__pycache__/
*.pyc
*.pyo
.venv/
venv/
.pytest_cache/

# Audit reports (generated by skill-compliance-auditor)
audit-*.md

# OS files
.DS_Store
Thumbs.db
