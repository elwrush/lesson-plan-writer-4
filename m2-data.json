    {
      "layout": "raw",
      "id": "answers-1",
      "step": 1,
      "background_color": "#052e0d",
      "body": "<style>.a-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px 40px;width:95%;margin:0 auto}.a-item{display:flex;align-items:baseline;gap:8px;color:#fff;font-size:34px;line-height:1.5}.a-num{color:#888;font-size:28px;min-width:36px}.a-word{color:#fff}.a-ans{color:#ffdd00;font-weight:700}</style><p style=\"color:#fff;text-align:center;font-size:36px;margin-bottom:15px;font-weight:700\">Answers — Set 1</p><div class=\"a-grid\"><div class=\"a-item\"><span class=\"a-num\">1.</span><span class=\"a-word\">rather</span><span class=\"a-ans\">&rarr; B. quite</span></div><div class=\"a-item\"><span class=\"a-num\">2.</span><span class=\"a-word\">camp</span><span class=\"a-ans\">&rarr; A. outdoor holiday</span></div><div class=\"a-item\"><span class=\"a-num\">3.</span><span class=\"a-word\">alone</span><span class=\"a-ans\">&rarr; D. by herself</span></div><div class=\"a-item\"><span class=\"a-num\">4.</span><span class=\"a-word\">ski</span><span class=\"a-ans\">&rarr; C. slide on snow</span></div><div class=\"a-item\"><span class=\"a-num\">5.</span><span class=\"a-word\">essay</span><span class=\"a-ans\">&rarr; B. written work</span></div><div class=\"a-item\"><span class=\"a-num\">6.</span><span class=\"a-word\">element</span><span class=\"a-ans\">&rarr; A. component</span></div><div class=\"a-item\"><span class=\"a-num\">7.</span><span class=\"a-word\">doubt</span><span class=\"a-ans\">&rarr; B. uncertainty</span></div><div class=\"a-item\"><span class=\"a-num\">8.</span><span class=\"a-word\">collection</span><span class=\"a-ans\">&rarr; D. set</span></div><div class=\"a-item\"><span class=\"a-num\">9.</span><span class=\"a-word\">stranger</span><span class=\"a-ans\">&rarr; C. unknown person</span></div><div class=\"a-item\"><span class=\"a-num\">10.</span><span class=\"a-word\">cap</span><span class=\"a-ans\">&rarr; A. soft hat</span></div></div>",
      "notes": "Items 1-10. Read aloud, pause for marking."
    },
    {
      "layout": "raw",
      "id": "answers-2",
      "step": 1,
      "background_color": "#052e0d",
